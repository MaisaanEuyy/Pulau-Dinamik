{
  "name": "dynamic-island-kw",
  "productName": "Dynamic Island KW",
  "version": "0.1.1",
  "private": true,
  "description": "MacBook-style Dynamic Island for Windows",
  "license": "MIT",
  "author": "Suparman Official",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run typecheck && npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "icons": "node scripts/gen-icons.mjs",
    "notify": "node scripts/notify.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "smoke": "npm run build && electron . --smoke-test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "koffi": "^3.3.4",
    "systeminformation": "^5.33.16"
  }
}
